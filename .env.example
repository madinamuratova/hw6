# Copy this file to .env in the project folder and fill in your own values.
# .env is listed in .gitignore, so it is never committed. Never put a real key in this example file.

# Required: your Portkey API key. Every model call (gpt-6-luna) goes through Portkey with it.
PORTKEY_API_KEY=your-portkey-api-key-here

# Optional: the Portkey gateway URL. This default works as it is.
PORTKEY_BASE_URL=https://api.portkey.ai/v1

# Optional, for the dashboard only: extra browser origins the API should allow (comma-separated).
# FRONTEND_ORIGINS=http://localhost:3000

# Optional, for tests only: point the MCP server at scratch copies instead of the real files.
# CAMPUS_CUSTOMS_DB=/tmp/campus_customs_scratch.db
# CAMPUS_CUSTOMS_DRAFTS=/tmp/drafts_scratch.json
# CAMPUS_CUSTOMS_AUDIT=/tmp/audit_scratch.json
